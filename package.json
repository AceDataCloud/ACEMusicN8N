{
  "name": "@acedatacloud/n8n-nodes-acemusic",
  "version": "0.1.3",
  "description": "Create ACE Music songs and lyrics, then retrieve the same task through Ace Data Cloud.",
  "license": "MIT",
  "homepage": "https://github.com/AceDataCloud/ACEMusicN8N",
  "keywords": [
    "n8n-community-node-package",
    "acedatacloud",
    "acemusic",
    "music",
    "music-generation",
    "acedata",
    "ace-data-cloud"
  ],
  "author": {
    "name": "Ace Data Cloud",
    "email": "dev@acedata.cloud",
    "url": "https://platform.acedata.cloud"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AceDataCloud/ACEMusicN8N.git"
  },
  "bugs": {
    "url": "https://github.com/AceDataCloud/ACEMusicN8N/issues"
  },
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "node --test tests/*.test.cjs",
    "prepublishOnly": "npm run build && npm run lint && npm test",
    "prebuild": "node scripts/fetch-brand-assets.mjs"
  },
  "files": [
    "dist/credentials",
    "dist/nodes",
    "examples"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/AceDataAceMusicApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/AceMusic/AceMusic.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.51.3",
    "typescript": "5.9.3",
    "prettier": "3.6.2",
    "eslint": "9.29.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
